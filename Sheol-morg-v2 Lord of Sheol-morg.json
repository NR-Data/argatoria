        "profiles": [
          {
            "name": "Myrnos",
            "id": "2111-75ff-6502-8784",
            "hidden": false,
            "page": 141,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "Driven by a whirlwind of madness, Myrnos always grants 5 attacks + 1 attack for each rank of the unit he is attached to.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          },
          {
            "name": "Hunger for Murder",
            "id": "c3f2-d641-8fdd-2ec2",
            "hidden": false,
            "page": 141,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [{"name": "Description", "$text": "The regrouping range of the unit Myrnos is attached to is 3D6 cm instead of 5 cm.", "typeId": "0061-13d8-7fda-179e"}]
          },
          {
            "name": "Azzantir, Axe of Malice",
            "id": "d9f0-5630-b701-f6fd",
            "hidden": false,
            "page": 141,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "If an enemy unit (but not single model) loses combat against a unit Myrnos is attached to, roll four D6s before the enemy takes a Cold Blood Test. For each score of 4 or less, Myrnos inflicts 1 additional Wound on the enemy unit. Any double of 6 means that the unit Myrnos is attached to loses 1 base.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          },
          {
            "name": "Servant’s Girdle",
            "id": "1bb6-1398-8df9-5901",
            "hidden": false,
            "page": 141,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [{"name": "Description", "$text": "If Myrnos is eliminated from battle, he does not count as a Blood Point for the opponent.", "typeId": "d8cb-c37d-4eab-001d"}]
          }
        ]
      },
