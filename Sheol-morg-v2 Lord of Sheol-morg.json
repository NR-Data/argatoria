        "profiles": [
          {
            "name": "Ab... huul! Daaqul, salib!!!",
            "id": "dd9a-d559-6f17-9a33",
            "hidden": false,
            "page": 95,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "Before the battle, Ritual Master performs a special ritual. Roll a D6 to check which bonuses the units will have during the battle.\n1–2 Ritual of Beast\nBasic and Elite Units in the army have their move and charge ranges increased by 2 cm.\n3–4 Ritual of Pain\nBasic and Elite Units in the army that have no save receive save. Each such unit may always roll a D6 for each Wound it is dealt. Each score of 1 means a cancelled Wound.\n5–6 Ritual of Fear\nBasic and Elite Units in the army have Fear. Fear. After a successful charge with this unit, the enemy unit (but not single model) must take a Panic Test for 1 base. If this unit is a Horde, the enemy must take a Panic Test for 2 bases instead.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          }
        ]
