        "rules": [
          {
            "name": "Evil Feeds Evil",
            "id": "5da0-aaee-b713-8d06",
            "description": "If Lord Necromancer attempts to summon a unit of the Damned, and there is already such a unit on the battlefield under his command, he may choose to reinforce the existing unit instead of creating a new one. When doing so, he may roll the summoning test on a 4 or less (instead of 2 or less) to summon 4 bases of the Damned. If the result is a 1, 8 bases are summoned instead of 4. A unit of the Damned may never exceed 16 bases in total.",
            "hidden": false,
            "page": 139,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          }
        ],
