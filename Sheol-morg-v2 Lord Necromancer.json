    "sharedRules": [
      {
        "name": "Skeletons Champions",
        "id": "5b98-0b5e-f927-ea6b",
        "description": "The specific magical aura of the Skeletons Champions prevents them from attaching to any units, as doing so would disrupt their ability to effectively support the army. If an enemy unit comes into contact with such a Champion and fails to eliminate it, the Champion must be repositioned up to 15 cm away, to any location on the battlefield.",
        "hidden": false,
        "page": 138,
