            "typeName": "Unit",
            "characteristics": [
              {"name": "LD", "$text": "5", "typeId": "cf8f-1c29-2b6f-3031"},
              {"name": "M", "$text": "10", "typeId": "879f-49c0-b3a8-c586"},
              {"name": "WS", "$text": "2", "typeId": "716f-8261-c374-f462"},
              {"name": "S", "$text": "5", "typeId": "65de-0c6b-9559-e9d4"},
              {"name": "T", "$text": "6", "typeId": "c9bb-0a5f-7e53-c580"},
              {"name": "A", "$text": "5", "typeId": "44b7-9a60-223f-8bd3"},
              {"name": "W", "$text": "5", "typeId": "c862-16aa-6d51-e80c"}
            ]
          }
        ],
        "rules": [
          {
            "name": "Sower of Graves",
            "id": "baf4-b747-7b9c-8ad7",
            "description": "When charging, Rotgant may roll a D6. The result determines the number of additional attacks it gains. However, on a roll of 6, Rotgant does not make any attacks. Instead, it stumbles and crashes directly into the enemy. Roll 2D6 – both the enemy and the Rotgant suffer that many Wounds. No saves are permitted against the Wounds caused by the Rotgant’s fall.",
            "hidden": false,
            "page": 134,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          },
          {
            "name": "Mage Hunter",
            "id": "0d4b-0fb7-ea00-d7ce",
            "description": "When Rotgant comes into contact with an enemy Mage, it eliminates them from play on a roll of 4 or less, instead of the usual 2 or less.",
            "hidden": false,
            "page": 134,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          },
          {
            "name": "Captured Artefacts",
            "id": "0b45-e3a6-2512-9b43",
            "description": "Once per battle, Rotgant can use a magic item, but must roll a D6 to see which item he has grabbed. Roll a D6.\n1-2 Scroll of Daze. Target enemy unit with WS 3 or greater gets -1 to WS.\n3-4 Ring of Destruction. Target unit gets +1 to S.\n6 Sack of Stuff. Unfortunately, upon examining the contents, Rotgant loses interest in the artefacts it has acquired. If Rotgant has an Action Die, it loses it.",
            "hidden": false,
            "page": 134,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          }
        ]
      },
