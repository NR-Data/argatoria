          {
            "name": "Lord Necromancer",
            "id": "ff5e-7380-bc66-44e3",
            "hidden": false,
            "page": 97,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "a4ee-546b-71a6-4250",
            "typeName": "General",
            "characteristics": [{"name": "LD", "$text": "1", "typeId": "3e75-c7bc-9bab-8c5e"}]
          }
        ],
        "rules": [
          {
            "name": "Your Souls Belong To Us!",
            "id": "22fd-fffc-3a65-7f97",
            "description": "If Lord Necromancer’s opponent rolls a 1 or 2 in an Initiative Test, he loses the test regardless of other rules, magic in any form, modifiers, or re-roll opportunities. In addition, if the opponent’s army has lost 5 Blood Points or more, you may roll a D6 once per cycle when activating Lord Necromancer. On a score of 2 or less, you may place a unit of The Damned* (4 bases) within 20 cm of Lord Necromancer, without an Action Die and facing any direction. In the subsequent cycles, the unit receives an Action Die and can be activated normally. It does not count towards lost Blood Points when destroyed.",
            "hidden": false,
            "page": 95,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          }
        ]
      },
