          {"name": "Appendix", "id": "2d39-369c-1c33-3faa", "hidden": false, "primary": false, "targetId": "3337-e6b7-f06f-9aec"},
          {"name": "Hero", "id": "d3c9-ce56-8e28-d8e9", "hidden": false, "primary": false, "targetId": "0b0b-5bbc-9d5e-9b0c"}
        ],
        "costs": [{"name": "Points", "typeId": "78f2-651d-2f2e-98bf", "value": 14}, {"name": "Bases", "typeId": "4f83-a514-6b6a-5475", "value": 1}],
        "entryLinks": [{"name": "Magic Banners", "id": "ef99-f650-d935-b03a", "hidden": false, "import": true, "targetId": "a82d-5866-f907-b48a", "type": "selectionEntryGroup"}],
        "rules": [
          {
            "name": "Skeletons Command Group",
            "id": "3204-37be-4bbd-8533",
            "description": "The specific magical aura of the Skeletons Command Groups prevents them from attaching to any units, as doing so would disrupt their ability to effectively support the army. If an enemy unit comes into contact with such a Command Group and fails to eliminate it, the Command Group must be repositioned up to 15 cm away, to any location on the battlefield.\n\n\nAll friendly units within 5 cm of a Skeletons Command Group may use the following rules:\n- After declaring a charge, the unit can (even despite the difficulties or obstacles) roll 3D6 for the charge instead of the roll that it could normally make, and choose the two highest dice rolls to make the charge.\n- The unit can make a special sideways or backwards move up to 10 cm + D6 instead of its standard move or charge.\n- After each lost combat, the unit of Truhlaks is allowed to re-roll a D6 roll for the additional Wounds it receives (Corpse Horde).",
            "hidden": false,
            "page": 139,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          }
        ]
      },
      {
