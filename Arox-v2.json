        "rules": [
          {
            "name": "Smash",
            "id": "e853-eeba-63a0-96d4",
            "description": "When charging, instead of gaining a +1 bonus to Strength (S), the unit’s Strength (S) is doubled.",
            "hidden": false,
            "page": 144,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          },
          {
            "name": "Forced Advance",
            "id": "28db-721e-1fa9-c0fd",
            "description": "A Naulen cannot regroup after defeating an enemy. Instead, it must roll 3D6 and move forward a distance equal to the result. If it encounters an enemy unit, it is treated as charging, and attacks must be resolved immediately. If it encounters a friendly unit, the Naulen stops 1 cm away from it. The friendly unit in the path takes 2 Wounds. If it reaches terrain or the edge of the table, it stops 5 cm away. If the Naulen does not encounter any units, it may turn to face any direction after completing its forced move.",
            "hidden": false,
            "page": 144,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          },
          {
            "name": "Devotee",
            "id": "266c-e0ec-c04b-1ad6",
            "description": "Naulen is a single model, but it is allowed to pray.",
            "hidden": false,
            "page": 144,
            "publicationId": "30f0-6ecb-d1bf-eb3e"
          }
        ]
      }
