        "costs": [{"name": "Points", "typeId": "78f2-651d-2f2e-98bf", "value": 41}, {"name": "Bases", "typeId": "4f83-a514-6b6a-5475", "value": 1}],
        "profiles": [
          {
            "name": "Valeria",
            "id": "74a1-3998-cd6b-873c",
            "hidden": false,
            "page": 151,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "Valeria is always accompanied by Andras and Iluar, who fight fiercely along her side in the Vaendral army. Thanks to them, Valeria grants the unit she is attached to +8 attacks.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          },
          {
            "name": "The Chosen of the Bathed in Blood",
            "id": "b804-cf2e-ab54-dcbf",
            "hidden": false,
            "page": 151,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "If the friendly General has left the battlefield, Valeria immediately takes command. The army can still use the Born Warriors special rule and use Valeria’s LD 2. Valeria cannot issue orders.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          },
          {
            "name": "Slayer’s Axe",
            "id": "7813-99cd-dfec-d47d",
            "hidden": false,
            "page": 151,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "When the unit Valeria is attached to is to make a Wound Test, take up to 2 dice from the pool and roll them separately. Each score of 3 or less means the enemy unit is dealt 3 Wounds.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          },
          {
            "name": "Feisty Savage",
            "id": "62fa-f0fd-fa14-a23d",
            "hidden": false,
            "page": 151,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "If an enemy unit successfully charges the unit with an Action Die that Valeria is attached to, the unit may immediately remove the Action Die, position itself facing the enemy, and perform its attacks before the enemy does.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          },
          {
            "name": "Skull of the Priest Esn",
            "id": "754c-881c-d9f0-31ff",
            "hidden": false,
            "page": 151,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "The power of the skull powder allows Valeria to attempt to dispel an enemy spell once per battle. A score of 3 or less means the spell has been dispelled.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          }
        ]
      },
