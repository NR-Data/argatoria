        "profiles": [
          {
            "name": "Mar’hauk",
            "id": "ffb3-d033-5450-79cf",
            "hidden": false,
            "page": 149,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "Mar’hauk mounts a powerful creature called Vitur. Thanks to Vitur, Mar’hauk grants the unit he is attached to +8 attacks.",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          },
          {
            "name": "Ern’s Helm",
            "id": "6244-9260-0ab5-e4e1",
            "hidden": false,
            "page": 149,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "When attached to a friendly unit that has no save, Mar’hauk allows it to benefit from the power of his helm. After being dealt Wounds by an enemy unit, a friendly unit may roll a D6 for each of up to 5 Wounds it has suffered. Each score of 2 or less means a cancelled Wound.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          },
          {
            "name": "Eagle Talon",
            "id": "274a-ab2c-87c7-e8da",
            "hidden": false,
            "page": 149,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "A friendly unit that Mar’hauk is attached to may re-roll 4 dice in the Wound Test + 1 die for each terrain on the battlefield.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          },
          {
            "name": "Oaken Shield",
            "id": "b1d2-93e7-78c1-dd6b",
            "hidden": false,
            "page": 149,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "88d9-934a-85e6-e7a3",
            "typeName": "Item",
            "characteristics": [
              {
                "name": "Description",
                "$text": "If an enemy unit comes into contact with Mar’hauk, it does not roll for the hero’s death. Instead, Mar’hauk may be immediately placed anywhere up to 20 cm of the enemy unit. The shield can only be used once per battle.",
                "typeId": "d8cb-c37d-4eab-001d"
              }
            ]
          },
          {
            "name": "Vitur",
            "id": "9223-9944-1ef1-0a47",
            "hidden": false,
            "page": 149,
            "publicationId": "30f0-6ecb-d1bf-eb3e",
            "typeId": "c120-4b08-0021-a1b1",
            "typeName": "Ability",
            "characteristics": [
              {
                "name": "Description",
                "$text": "The unit that Mar’hauk on Vitur is attached to has Fear (After a successful charge with this unit, the enemy unit (but not single model) must take a Panic Test for 1 base. If this unit is a Horde, the enemy must take a Panic Test for 2 bases instead).",
                "typeId": "0061-13d8-7fda-179e"
              }
            ]
          }
        ]
      }
